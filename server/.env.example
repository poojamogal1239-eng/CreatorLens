# Port configuration
PORT=5000

# Supabase credentials (get these from Project Settings -> API)
SUPABASE_URL=https://your-supabase-project-id.supabase.co
# Use service_role secret on backend to bypass RLS safely for administrative and automated tasks
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# n8n Webhook trigger URLs
N8N_WEBHOOK_PROFILE=http://localhost:5678/webhook/trigger-profile-enrichment
N8N_WEBHOOK_CAMPAIGN=http://localhost:5678/webhook/trigger-campaign-matching
