    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $('Webhook Trigger').first().json.body.gemini_api_key || 'YOUR_API_KEY_FALLBACK' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Analyze this campaign brief objective:\\nTitle: {{ $('Fetch Campaign Brief').first().json.title }}\\nObjective: {{ $('Fetch Campaign Brief').first().json.objective }}\\nCategory: {{ $('Fetch Campaign Brief').first().json.category }}\\nTarget Audience: {{ $('Fetch Campaign Brief').first().json.target_audience }}\\nCreator Type Requirement: {{ $('Fetch Campaign Brief').first().json.creator_type }}\\n\\nYou MUST return strict JSON only. Do not include markdown code block formatting backticks (like ```json). The output must match this JSON schema:\\n{\\n  \\\"ai_keywords\\\": [\\\"keyword1\\\", \\\"keyword2\\\", \\\"keyword3\\\", \\\"keyword4\\\"],\\n  \\\"ai_tier\\\": \\\"Micro-Influencer (10K - 100K)\\\"\\n}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "3e8df5db-8f83-4a1d-b8d9-6c3e7f41cf6d",
      "name": "Gemini - Parse Brief (WF-04)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        630,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const responseText = $('Gemini - Parse Brief (WF-04)').first().json.candidates[0].content.parts[0].text;\nconst jsonMatch = responseText.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/) || [null, responseText];\nconst jsonString = jsonMatch[1].trim();\nconst parsed = JSON.parse(jsonString);\n\nreturn [{\n  ai_keywords: Array.isArray(parsed.ai_keywords) ? parsed.ai_keywords : [],\n  ai_tier: parsed.ai_tier || 'Micro-Influencer (10K - 100K)'\n}];"
      },
      "id": "3e8df5db-8f83-4a1d-b8d9-6c3e7f41cf6f",
      "name": "Parse Gemini Response (WF-04)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        480
      ]
    },
