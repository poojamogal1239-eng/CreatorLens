    {
      "parameters": {
        "jsCode": "const campaign = $('Fetch Campaign Brief').first().json;\nconst creators = $('Fetch All Candidates').all().map(item => item.json);\nconst scoresList = $('Fetch Candidate Scores').all().map(item => item.json);\n\nconst scoresMap = {};\nscoresList.forEach(s => {\n  scoresMap[s.creator_id] = s;\n});\n\nconst matchedList = [];\n\ncreators.forEach(creator => {\n  let matchScore = 50; // Base score\n  const explanationLines = [];\n  \n  // Language match (+15)\n  if (creator.languages.includes(campaign.language)) {\n    matchScore += 15;\n    explanationLines.push(\"Language alignment match\");\n  }\n  \n  // Region match (+15)\n  if (creator.regions.includes(campaign.region)) {\n    matchScore += 15;\n    explanationLines.push(`Strong regional footprint in ${campaign.region}`);\n  }\n  \n  // Niche match (+15)\n  if (creator.categories.includes(campaign.category)) {\n    matchScore += 15;\n    explanationLines.push(`Matches campaign category: ${campaign.category}`);\n  }\n  \n  // Creator Intelligence Score contribution (+15)\n  const scores = scoresMap[creator.id];\n  const intelligence = scores ? scores.intelligence_score : 50;\n  const scoreWeight = Math.round(intelligence * 0.15);\n  matchScore += scoreWeight;\n  if (intelligence >= 80) {\n    explanationLines.push(\"Exceptional Creator Intelligence profile\");\n  }\n  \n  // Budget alignment check (+10)\n  if (campaign.budget >= creator.pricing_min) {\n    matchScore += 10;\n    explanationLines.push(\"Pricing fits within campaign budget\");\n  }\n  \n  matchScore = Math.min(100, matchScore);\n  \n  // Price Recommendation (WF-06)\n  const recPrice = Math.round((creator.followers_count * 0.15 + creator.average_views * 0.5) * (intelligence / 80));\n  const roundedRec = Math.max(5000, Math.round(recPrice / 1000) * 1000);\n  const minPrice = Math.round(roundedRec * 0.8);\n  const premiumPrice = Math.round(roundedRec * 1.3);\n  const pricingJustification = `Fair valuation calculated at ₹${roundedRec.toLocaleString('en-IN')} based on ${creator.engagement_rate}% engagement rate, ${creator.average_views} average views, and verified ${creator.languages.join('/')} content footprint.`;\n  \n  matchedList.push({\n    campaign_id: campaign.id,\n    creator_id: creator.id,\n    match_score: matchScore,\n    match_explanation: explanationLines.join(', ') || 'General profile alignment',\n    min_price: minPrice,\n    recommended_price: roundedRec,\n    premium_price: premiumPrice,\n    pricing_justification: pricingJustification,\n    status: 'recommended'\n  });\n});\n\n// Sort by match score descending\nmatchedList.sort((a, b) => b.match_score - a.match_score);\n\nreturn matchedList.slice(0, 10); // Return top 10 matches"
      },
