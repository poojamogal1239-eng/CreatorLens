        ],
        "values": {
          "status": "Completed",
          "completed_at": "={{ new Date().toISOString() }}",
          "execution_time_ms": "={{ Date.now() - new Date($('Webhook Trigger').first().json.timestamp).getTime() }}",
          "output_payload": "={{ JSON.stringify({ success: true, ai_model: 'Gemini-1.5-pro' }) }}"
        }
      },
      "id": "cd8df5db-8f83-4a1d-b8d9-6c3e7f41cf8a",
      "name": "Update Workflow Log",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        2430,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\n  \"success\": true,\n  \"message\": \"Creator profile successfully analyzed, scored, and suggestions generated.\",\n  \"creator_id\": \"{{ $('Webhook Trigger').first().json.body.creator_id }}\",\n  \"job_id\": \"{{ $('Webhook Trigger').first().json.body.job_id }}\",\n  \"trace_id\": \"{{ $('Webhook Trigger').first().json.body.trace_id }}\"\n}",
        "options": {}
      },
      "id": "dd8df5db-8f83-4a1d-b8d9-6c3e7f41cf8b",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2610,
        300
      ]
    }
  ],
