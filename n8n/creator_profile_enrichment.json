    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $('Webhook').first().json.body.gemini_api_key || 'YOUR_API_KEY_FALLBACK' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Analyze this creator profile:\\nName: {{ $('Fetch creator profile').first().json.full_name }}\\nBio: {{ $('Fetch creator profile').first().json.bio }}\\nCategories: {{ ($('Fetch creator profile').first().json.categories || []).join(', ') }}\\nLanguages: {{ ($('Fetch creator profile').first().json.languages || []).join(', ') }}\\nRegions: {{ ($('Fetch creator profile').first().json.regions || []).join(', ') }}\\nFollowers: {{ $('Fetch creator profile').first().json.followers_count }}\\nAverage Views: {{ $('Fetch creator profile').first().json.average_views }}\\nEngagement Rate: {{ $('Fetch creator profile').first().json.engagement_rate }}%\\n\\nYou MUST return strict JSON only. Do not include markdown code block formatting backticks (like ```json). The output must match this JSON schema:\\n{\\n  \\\"profile_summary\\\": \\\"Provide a summary of their profile...\\\",\\n  \\\"profile_completeness\\\": 85,\\n  \\\"strengths\\\": [\\\"strength1\\\", \\\"strength2\\\"],\\n  \\\"weaknesses\\\": [\\\"weakness1\\\", \\\"weakness2\\\"],\\n  \\\"missing_information\\\": [\\\"missing1\\\"],\\n  \\\"intelligence_score\\\": 85,\\n  \\\"audience_trust\\\": 80,\\n  \\\"engagement_rate_score\\\": 75,\\n  \\\"regional_influence\\\": 90,\\n  \\\"content_consistency\\\": 85,\\n  \\\"brand_readiness\\\": 80,\\n  \\\"ai_explanation\\\": \\\"Provide a detailed explanation of their score...\\\"\\n}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "4d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6b",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const responseText = $('HTTP Request').first().json.candidates[0].content.parts[0].text;\nconst jsonMatch = responseText.match(/```(?:json)?\\s*([\\s\\S]*?)\\s*```/) || [null, responseText];\nconst jsonString = jsonMatch[1].trim();\nconst parsed = JSON.parse(jsonString);\n\nreturn [{ \n  creator_id: $('Code in JavaScript').first().json.creator_id,\n  profile_summary: parsed.profile_summary || 'Enriched Profile',\n  profile_completeness: parseInt(parsed.profile_completeness) || 80,\n  strengths: Array.isArray(parsed.strengths) ? parsed.strengths : [],\n  weaknesses: Array.isArray(parsed.weaknesses) ? parsed.weaknesses : [],\n  missing_information: Array.isArray(parsed.missing_information) ? parsed.missing_information : [],\n  intelligence_score: parseInt(parsed.intelligence_score) || 75,\n  audience_trust: parseInt(parsed.audience_trust) || 75,\n  engagement_rate_score: parseInt(parsed.engagement_rate_score) || 75,\n  regional_influence: parseInt(parsed.regional_influence) || 75,\n  content_consistency: parseInt(parsed.content_consistency) || 75,\n  brand_readiness: parseInt(parsed.brand_readiness) || 75,\n  ai_explanation: parsed.ai_explanation || 'Scores computed using Gemini.'\n}];"
      },
      "id": "5d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6b",
