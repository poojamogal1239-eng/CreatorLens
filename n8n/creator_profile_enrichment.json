{
  "name": "CreatorLens - Creator Profile Enrichment Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "creator-profile-analysis",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "1d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6b",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "ai_jobs",
        "id": "={{ $json.body.job_id }}",
        "columns": [
          "status",
          "started_at"
        ],
        "values": {
          "status": "Processing",
          "started_at": "={{ new Date().toISOString() }}"
        }
      },
      "id": "1d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6a",
      "name": "Update AI Job - Processing",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        280,
        300
      ]
    },
    {
      "parameters": {
        "operation": "get",
        "table": "creators",
        "id": "={{ $('Webhook Trigger').first().json.body.creator_id }}"
      },
      "id": "2d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6c",
      "name": "Fetch Creator Profile",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-1.5-pro",
        "prompt": "=Analyze the following creator profile data:\nFull Name: {{ $json.full_name }}\nBio: {{ $json.bio }}\nCategories: {{ $json.categories.join(', ') }}\nLanguages: {{ $json.languages.join(', ') }}\nRegions: {{ $json.regions.join(', ') }}\n\nGenerate a structured JSON output with the following fields:\n1. profile_summary (2-3 sentences explaining their niche and market value)\n2. strengths (array of 3 strings of their core engagement strengths)\n3. weaknesses (array of 2 strings highlighting growth channels)\n4. missing_information (array of missing pieces from their profile)\n5. profile_completeness (integer 0-100 indicating profile depth)\n6. confidence_score (decimal 0.0-1.0 representing analysis confidence)"
      },
      "id": "3d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6d",
      "name": "Gemini - Profile Analysis (WF-01)",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [
        630,
        300
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "table": "creator_ai_analysis",
        "columns": [
          "creator_id",
          "profile_summary",
          "profile_completeness",
          "strengths",
          "weaknesses",
          "missing_information",
          "ai_version",
          "workflow_version",
          "confidence_score"
        ],
        "values": {
          "creator_id": "={{ $('Webhook Trigger').item.json.body.creator_id }}",
          "profile_summary": "={{ $json.profile_summary }}",
          "profile_completeness": "={{ $json.profile_completeness }}",
          "strengths": "={{ $json.strengths }}",
          "weaknesses": "={{ $json.weaknesses }}",
          "missing_information": "={{ $json.missing_information }}",
          "ai_version": "Gemini-1.5-pro",
          "workflow_version": "WF-v1.0",
          "confidence_score": "={{ $json.confidence_score }}"
        }
      },
      "id": "4d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6e",
      "name": "Save AI Analysis",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        810,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const creator = $('Fetch Creator Profile').first().json;\nconst analysis = $('Gemini - Profile Analysis (WF-01)').first().json;\n\n// Calculate metrics dynamically\nconst baseEngagement = creator.engagement_rate || 5.0;\nconst trust = Math.min(100, Math.round(75 + baseEngagement * 2));\nconst engagement = Math.min(100, Math.round(60 + baseEngagement * 4));\nconst regional = creator.regions.includes('Pune') || creator.regions.includes('Indore') || creator.languages.includes('Marathi') || creator.languages.includes('Bundeli') || creator.languages.includes('Telugu') ? 92 : 75;\nconst consistency = Math.min(100, Math.round(70 + Math.random() * 20));\nconst readiness = Math.min(100, Math.round(80 + (creator.pricing_min ? 10 : 0)));\nconst completeness = analysis.profile_completeness || 85;\n\nconst finalScore = Math.round(\n  trust * 0.25 +\n  engagement * 0.20 +\n  regional * 0.20 +\n  consistency * 0.15 +\n  readiness * 0.10 +\n  completeness * 0.10\n);\n\nreturn [{\n  creator_id: creator.id,\n  intelligence_score: finalScore,\n  audience_trust: trust,\n  engagement_rate_score: engagement,\n  regional_influence: regional,\n  content_consistency: consistency,\n  brand_readiness: readiness\n}];"
      },
      "id": "5d8df5db-8f83-4a1d-b8d9-6c3e7f41cf6f",
      "name": "JS - Score Engine (WF-02)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        990,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-1.5-pro",
        "prompt": "=Write a 2-sentence explanation of why this creator received a Creator Intelligence Score of {{ $json.intelligence_score }}/100 based on their metrics:\nAudience Trust Score: {{ $json.audience_trust }}\nEngagement Rate Score: {{ $json.engagement_rate_score }}\nRegional Influence: {{ $json.regional_influence }}\nContent Consistency: {{ $json.content_consistency }}\nBrand Readiness: {{ $json.brand_readiness }}\n"
      },
      "id": "6d8df5db-8f83-4a1d-b8d9-6c3e7f41cf7a",
      "name": "Gemini - AI Explanation",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [
        1170,
        300
      ]
    },
    {
      "parameters": {
        "operation": "upsert",
        "table": "creator_scores",
        "columns": [
          "creator_id",
          "intelligence_score",
          "audience_trust",
          "engagement_rate_score",
          "regional_influence",
          "content_consistency",
          "brand_readiness",
          "ai_explanation"
        ],
        "values": {
          "creator_id": "={{ $('JS - Score Engine (WF-02)').item.json.creator_id }}",
          "intelligence_score": "={{ $('JS - Score Engine (WF-02)').item.json.intelligence_score }}",
          "audience_trust": "={{ $('JS - Score Engine (WF-02)').item.json.audience_trust }}",
          "engagement_rate_score": "={{ $('JS - Score Engine (WF-02)').item.json.engagement_rate_score }}",
          "regional_influence": "={{ $('JS - Score Engine (WF-02)').item.json.regional_influence }}",
          "content_consistency": "={{ $('JS - Score Engine (WF-02)').item.json.content_consistency }}",
          "brand_readiness": "={{ $('JS - Score Engine (WF-02)').item.json.brand_readiness }}",
          "ai_explanation": "={{ $json.text }}"
        }
      },
      "id": "7d8df5db-8f83-4a1d-b8d9-6c3e7f41cf7b",
      "name": "Save Intelligence Scores",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1350,
        300
      ]
    },
    {
      "parameters": {
        "model": "gemini-1.5-pro",
        "prompt": "=Generate 3 growth suggestions (as a JSON array of objects, each containing fields: suggestion_text, impact_level ['high','medium','low'], expected_improvement [integer score points]) to help this creator increase their scores.\nWeaknesses: {{ $('Gemini - Profile Analysis (WF-01)').first().json.weaknesses.join(', ') }}\nScore Explanation: {{ $('Gemini - AI Explanation').first().json.text }}"
      },
      "id": "8d8df5db-8f83-4a1d-b8d9-6c3e7f41cf7c",
      "name": "Gemini - growth suggestions (WF-03)",
      "type": "n8n-nodes-base.googleGemini",
      "typeVersion": 1,
      "position": [
        1530,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const suggestions = JSON.parse($('Gemini - growth suggestions (WF-03)').first().json.text);\nconst creatorId = $('Webhook Trigger').first().json.body.creator_id;\n\nreturn suggestions.map(s => ({\n  creator_id: creatorId,\n  suggestion_text: s.suggestion_text,\n  impact_level: s.impact_level,\n  expected_improvement: s.expected_improvement\n}));"
      },
      "id": "9d8df5db-8f83-4a1d-b8d9-6c3e7f41cf7d",
      "name": "JS - Format suggestions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1710,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "creator_ai_suggestions",
        "columns": [
          "creator_id",
          "suggestion_text",
          "impact_level",
          "expected_improvement"
        ],
        "values": {
          "creator_id": "={{ $json.creator_id }}",
          "suggestion_text": "={{ $json.suggestion_text }}",
          "impact_level": "={{ $json.impact_level }}",
          "expected_improvement": "={{ $json.expected_improvement }}"
        }
      },
      "id": "ad8df5db-8f83-4a1d-b8d9-6c3e7f41cf7e",
      "name": "Save suggestions",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1890,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "table": "creators",
        "id": "={{ $('Webhook Trigger').first().json.body.creator_id }}",
